{
  "index": "cohere_wiki",
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "-1"
  },
  "mappings": {
    "_source": { "excludes": ["emb"] },
    "properties": {
      "url": { "type": "keyword", "index": false },
      "title": { "type": "text", "index": false },
      "text": { "type": "text", "analyzer": "english" },
      "emb": {
        "type": "dense_vector",
        "dims": 1024,
        "index": true,
        "similarity": "cosine",
        "index_options": { "type": "hnsw", "m": 16, "ef_construction": 64 }
      }
    }
  }
}
